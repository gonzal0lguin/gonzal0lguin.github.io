# Base URL of the photo library used by posts. Relative image paths in Markdown
# ("la-cruz/ridge.jpg") are resolved against it, so the photos themselves can live outside
# the repo (Cloudflare R2, Cloudinary, ...). See "Photos" in the README.
# Unset, photos are served from the repo at /assets/img/posts.
# PUBLIC_MEDIA_BASE_URL=https://photos.example.com

# Optional: used by `npm run translate` to translate Spanish content into English.
# ANTHROPIC_API_KEY=sk-ant-...
