---
// Interactive GPS route for a mountaineering entry: map colored by grade/elevation/heart rate,
// elevation profile linked to the map, route replay, stats and a day-by-day breakdown.
// The GPX file(s) are analyzed at build time (src/lib/gpx.ts); the browser only gets the result.
// The markup comes from src/lib/route-card.ts, which the route tool also uses in the browser.
import { loadRoute, routeFileList, type RouteFiles } from "../lib/gpx";
import { renderRouteCard } from "../lib/route-card";
import { placePhotos, type PostPhoto } from "../lib/photos";
import { getLangFromUrl } from "../i18n/ui";

export interface Props {
  /** Public path of the .gpx file, or of each part of a route recorded in several files */
  files: RouteFiles;
  /** URL offered by the download button; defaults to the (first) file */
  download?: string;
  title?: string;
  /** IANA timezone used to show clock times */
  timezone?: string;
  /** Photos of the post; those with a known location appear on the map */
  photos?: PostPhoto[];
}

const { files, download = routeFileList(files)[0], title, timezone = "America/Santiago", photos } = Astro.props;
const route = loadRoute(files);
const html = renderRouteCard(route, {
  lang: getLangFromUrl(Astro.url),
  title,
  timezone,
  download,
  photos: placePhotos(photos, route, timezone),
});
---

<Fragment set:html={html} />

<script>
  // Runs on the first load and after every view-transition navigation. The map code (and
  // Leaflet) is only downloaded when the page actually has a route.
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-route-map]")) return;
    const { initRouteMaps } = await import("../scripts/route-map");
    initRouteMaps();
  });
</script>
