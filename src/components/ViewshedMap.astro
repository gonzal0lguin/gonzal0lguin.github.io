---
// Everything a summit can see, as a map: the viewshed computed by scripts/lib/viewshed.mjs
// (already in Web Mercator) over a grey relief, with distance rings and the summits worth naming.
// With no props it is the hill of the reforestation post (public/assets/cerro/viewshed.png); given
// a summit's panorama `data` it shows that summit's, whose overlay also carries the glacier ice.
// Leaflet loads on demand.
import { PANORAMA as HILL_PANORAMA } from "../data/hill";
import type { PanoramaData } from "../lib/summits";
import "../styles/inventory.css";
import "../styles/summits.css";
import { languages, getLangFromUrl, localizePath, useTranslations } from "../i18n/ui";

export interface Props {
  data?: PanoramaData;
  title?: string;
  note?: string;
  /** Name on the viewpoint's marker. */
  summitLabel?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = languages[lang].locale;
const number = (value: number, digits = 0) =>
  value.toLocaleString(locale, { minimumFractionDigits: digits, maximumFractionDigits: digits });

const { data: panorama = HILL_PANORAMA as unknown as PanoramaData, summitLabel = t("cerro.viewshed.summit") } = Astro.props;
const stats = panorama.stats;
const {
  title = t("cerro.viewshed.title"),
  note = t("cerro.viewshed.note", { area: number(stats.visibleArea), share: number(stats.visibleShare * 100, 1), far: number(stats.farthest.distance) }),
} = Astro.props;

// The summits worth a name on the map: the named ones, and the highest that stand on the skyline
// (above 3,500 m for the hill; for a summit, its 30 highest).
const height = (peak: PanoramaData["peaks"][number]) => peak.ele ?? peak.model;
const skyline = panorama.peaks.filter((peak) => peak.status !== "hidden" && peak.skyline);
const threshold = Astro.props.data ? (skyline.map(height).sort((a, b) => b - a)[29] ?? 0) : 3500;
const peaks = panorama.peaks
  .filter((peak) => peak.named || (peak.status !== "hidden" && peak.skyline && height(peak) > threshold))
  .map((peak) => ({
    name: peak.name,
    lat: peak.lat,
    lon: peak.lon,
    ele: height(peak),
    distance: peak.distance,
    status: peak.status,
    named: peak.named,
    url: peak.summit
      ? localizePath(lang, `/ascents/summits/${peak.summit}/`)
      : peak.ascent
        ? localizePath(lang, `/ascents/${peak.ascent.slug}/`)
        : null,
  }));

const hasIce = !!panorama.glaciers?.count;
const data = {
  viewpoint: panorama.viewpoint,
  overlay: panorama.viewshed,
  peaks,
  labels: {
    summit: summitLabel,
    visible: t("cerro.panorama.visible"),
    borderline: t("cerro.panorama.borderline"),
    hidden: t("cerro.panorama.hidden"),
    climbed: t("cerro.panorama.climbed"),
    layer: t("cerro.viewshed.layer"),
  },
};
---

<section class="viewshed not-prose iv-block" data-viewshed>
  {title && <h3 class="iv-block__title">{title}</h3>}
  {note && <p class="iv-note">{note}</p>}
  <div class="viewshed__map" data-viewshed-map role="region" aria-label={title || t("cerro.viewshed.title")}></div>
  <div class="iv-legend">
    <span class="iv-legend__item"><i class="viewshed__swatch"></i>{t("cerro.viewshed.legend")}</span>
    {
      hasIce && (
        <>
          <span class="iv-legend__item"><i class="viewshed__swatch viewshed__swatch--ice"></i>{t("summit.viewshed.ice")}</span>
          <span class="iv-legend__item"><i class="viewshed__swatch viewshed__swatch--ice-hidden"></i>{t("summit.viewshed.iceHidden")}</span>
        </>
      )
    }
    <span class="iv-legend__item"><i class="viewshed__ring"></i>{t("cerro.viewshed.rings")}</span>
  </div>
  <script type="application/json" data-viewshed-data set:html={JSON.stringify(data)} />
</section>


<script>
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-viewshed]")) return;
    const { initViewshedMap } = await import("../scripts/viewshed-map");
    initViewshedMap();
  });
</script>
