---
// Route analyzer: visitors drop one or more GPX files and get the same route card as the posts,
// plus the stitched GPX. Everything runs in the browser (src/scripts/route-tool.ts); nothing is
// uploaded. Self-contained so it can move to a future "tools" section as is.
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="route-tool not-prose" data-route-tool data-lang={lang}>
  <label
    class="route-tool__drop group flex cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-base-content/20 bg-base-200 px-6 py-12 text-center transition-colors hover:border-primary hover:bg-base-200/70"
    data-dropzone
  >
    <span class="grid h-14 w-14 place-items-center rounded-full bg-primary/15 text-primary transition-transform group-hover:-translate-y-0.5">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path>
      </svg>
    </span>
    <span class="text-lg font-semibold">{t("tools.route.drop")}</span>
    <span class="text-sm text-base-content/70">{t("tools.route.choose")} · {t("tools.route.multi")}</span>
    <input type="file" accept=".gpx,application/gpx+xml" multiple class="sr-only" data-input />
  </label>

  <p class="mt-3 flex items-center justify-center gap-1.5 text-xs text-base-content/60">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
    </svg>
    {t("tools.route.privacy")}
  </p>

  <div role="alert" class="alert alert-error mt-4 whitespace-pre-line text-sm" data-error hidden></div>

  <div class="mt-6 rounded-2xl bg-base-200 p-4 sm:p-5" data-files hidden>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="font-semibold">{t("tools.route.files")} <span class="badge badge-sm badge-primary align-middle" data-count></span></h2>
        <p class="text-xs text-base-content/60" data-order></p>
      </div>
      <div class="flex gap-2">
        <button type="button" class="btn btn-ghost btn-sm" data-add>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          {t("tools.route.add")}
        </button>
        <button type="button" class="btn btn-ghost btn-sm text-error" data-clear>{t("tools.route.clear")}</button>
      </div>
    </div>
    <ol class="mt-3 flex flex-col gap-2" data-list></ol>
  </div>

  <div class="scroll-mt-4" data-result></div>
</section>

<script>
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-route-tool]")) return;
    const { initRouteTool } = await import("../scripts/route-tool");
    initRouteTool();
  });
</script>

<style is:global>
  .route-tool [data-dropzone][data-dragging] {
    border-color: oklch(var(--p));
    background: oklch(var(--p) / 0.08);
  }
</style>
