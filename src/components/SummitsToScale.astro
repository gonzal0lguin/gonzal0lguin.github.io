---
// My summits side by side, to scale: each one as its own outline — a slice of the terrain
// through its top, from the side it stands out most (scripts/profiles.mjs) — lowest to highest.
// Every cell is the same width of ground and every outline is drawn at the same metres per
// pixel, height and width alike, so they wrap onto as many rows as the screen needs and still
// compare: the grid columns are equal and each row stands on sea level. The sides are cut
// straight, a slice of the range rather than a mountain floating on its own. A summit I only
// attempted is drawn hollow. Hover or focus a mountain for its numbers; each links to its page.
import type { Summit } from "../lib/summits";
import PROFILES from "../data/profiles.json";
import { compassPoint, formatDate, getLangFromUrl, languages, localizePath, useTranslations } from "../i18n/ui";

export interface Props {
  summits: Summit[];
}

interface Profile {
  from: number;
  side: "track" | "north";
  top: number;
  points: [number, number][];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = languages[lang].locale;
const summits = Astro.props.summits.filter((summit) => summit.ascents.length).sort((a, b) => a.data.elevation - b.data.elevation);

/** Half the ground shown in each cell, m. The outlines are computed 4 km out; this crops them. */
const HALF = 2500;
/** Sky above each top, m, so the highest point doesn't touch the cell edge. */
const HEADROOM = 250;
const f = (value: number) => Math.round(value * 10) / 10;

const cells = summits.map((summit) => {
  const elevation = summit.data.elevation;
  const height = elevation + HEADROOM;
  const profile = (PROFILES as Record<string, Profile>)[summit.id];
  // Lifted or lowered as a whole so the top lands on the official height, not the model's. The
  // ground past HALF stays in the path for the view box to crop, so no edge needs working out.
  const points: [number, number][] = profile
    ? profile.points.map(([u, h]) => [u, h + elevation - profile.top])
    : // Not computed yet (npm run profiles): a plain cone until it is.
      [[-HALF, elevation * 0.45], [0, elevation], [HALF, elevation * 0.45]];
  const outline = `M${points.map(([u, h]) => `${u} ${f(height - h)}`).join("L")}`;
  const ground = `L${points.at(-1)![0]} ${height}L${points[0][0]} ${height}Z`;
  const reached = summit.ascents.filter((ascent) => !ascent.attempt).length;
  const label = [
    summit.data.name,
    `${elevation.toLocaleString(locale)} m${summit.data.region ? ` · ${summit.data.region}` : ""}`,
    reached
      ? t(summit.ascents.length === 1 ? "summits.visitsOne" : "summits.visitsMany", { n: summit.ascents.length })
      : t("ascent.attempt"),
    summit.last ? t("chart.last", { date: formatDate(summit.last, lang) }) : "",
    profile ? t("chart.scale.from", { dir: compassPoint(profile.from, lang) }) : "",
  ].filter(Boolean).join("\n");
  const grid = Array.from({ length: Math.floor(height / 1000) }, (_, i) => height - (i + 1) * 1000);
  return { summit, height, outline, ground, grid, attempt: reached === 0, label };
});
---

<figure class="summit-ui chart-block" data-chart>
  <figcaption class="chart-block__head">
    <h3 class="iv-block__title">{t("chart.scale.title")}</h3>
    <p class="iv-note">{t("chart.scale.note", { n: summits.length })}</p>
  </figcaption>
  <ol class="scale-range">
    {
      cells.map((cell) => {
        const shade = `scale-shade-${cell.summit.id}`;
        return (
          <li>
            <a
              href={localizePath(lang, `/ascents/summits/${cell.summit.id}/`)}
              class:list={["scale-peak", { "scale-peak--attempt": cell.attempt }]}
              data-tip={cell.label}
              aria-label={cell.label.replaceAll("\n", ", ")}
            >
              <svg class="scale-peak__view" viewBox={`${-HALF} 0 ${2 * HALF} ${cell.height}`} aria-hidden="true">
                <defs>
                  {/* Solid along the outline, thinning towards sea level: the shape is the point. */}
                  <linearGradient id={shade} x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0.15" class="scale-peak__stop" />
                    <stop offset="1" class="scale-peak__stop scale-peak__stop--low" />
                  </linearGradient>
                </defs>
                {cell.grid.map((y) => <line class="scale-peak__grid" x1={-HALF} x2={HALF} y1={y} y2={y} />)}
                <path class="scale-peak__fill" d={cell.outline + cell.ground} fill={`url(#${shade})`} />
                <path class="scale-peak__edge" d={cell.outline} />
                <line class="scale-peak__ground" x1={-HALF} x2={HALF} y1={cell.height} y2={cell.height} />
              </svg>
              <span class="scale-peak__name">{cell.summit.data.name.replace(/^(Cerro|Volcán) /, "")}</span>
              <span class="scale-peak__ele iv-num">{cell.summit.data.elevation.toLocaleString(locale)} m</span>
            </a>
          </li>
        );
      })
    }
  </ol>
  <div class="iv-legend">
    <span class="iv-legend__item"><svg width="16" height="12" aria-hidden="true"><path class="scale-swatch" d="M1 11 8 1l7 10" /></svg>{t("chart.scale.reached")}</span>
    <span class="iv-legend__item"><svg width="16" height="12" aria-hidden="true"><path class="scale-swatch scale-swatch--attempt" d="M1 11 8 1l7 10" /></svg>{t("chart.scale.attempt")}</span>
  </div>
</figure>
