---
// My summits side by side, to scale: one mountain per summit, as tall as it is high, lowest to
// highest, the taller ones standing behind like a range that rises away. One series, so one colour; a summit I only attempted is drawn hollow. Hover or focus
// a mountain for its numbers; each one links to its summit page.
import type { Summit } from "../lib/summits";
import { formatDate, getLangFromUrl, languages, localizePath, useTranslations } from "../i18n/ui";

export interface Props {
  summits: Summit[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = languages[lang].locale;
const summits = Astro.props.summits.filter((summit) => summit.ascents.length).sort((a, b) => a.data.elevation - b.data.elevation);

const W = 880;
const H = 250;
const LEFT = 58;
const RIGHT = 12;
const TOP = 14;
const BOTTOM = 74;
const top = Math.ceil(Math.max(...summits.map((summit) => summit.data.elevation), 1000) / 1000) * 1000;
const y = (metres: number) => TOP + (1 - metres / top) * (H - TOP - BOTTOM);
/** Each mountain's half-width, in steps between centres: neighbours share only their feet. */
const SPREAD = 0.68;
const step = (W - LEFT - RIGHT) / Math.max(1, summits.length - 1 + 2 * SPREAD);
const half = Math.min(step * SPREAD, 70);
const base = H - BOTTOM;
/** Centres spread so the first and last mountains' feet stay inside the plot. */
const xAt = (i: number) => (summits.length > 1 ? LEFT + half + ((W - LEFT - RIGHT - 2 * half) * i) / (summits.length - 1) : (LEFT + W - RIGHT) / 2);
const f = (value: number) => Math.round(value * 10) / 10;

const peaks = summits.map((summit, i) => {
  const x = xAt(i);
  const tip = y(summit.data.elevation);
  // Slightly lopsided, alternating, so the range doesn't read as a row of teeth.
  const lean = i % 2 ? 0.06 : -0.06;
  const outline = `M${f(x - half * (1 + lean))} ${base}L${f(x)} ${f(tip)}L${f(x + half * (1 - lean))} ${base}`;
  const reached = summit.ascents.filter((ascent) => !ascent.attempt).length;
  const label = [
    summit.data.name,
    `${summit.data.elevation.toLocaleString(locale)} m${summit.data.region ? ` · ${summit.data.region}` : ""}`,
    reached
      ? t(summit.ascents.length === 1 ? "summits.visitsOne" : "summits.visitsMany", { n: summit.ascents.length })
      : t("ascent.attempt"),
    summit.last ? t("chart.last", { date: formatDate(summit.last, lang) }) : "",
  ].filter(Boolean).join("\n");
  return { summit, x, tip, outline, attempt: reached === 0, label };
});
// Tallest first, so each smaller mountain stands in front of the next one up.
const drawOrder = [...peaks].reverse();
const grid = Array.from({ length: top / 1000 + 1 }, (_, i) => i * 1000);
---

<figure class="summit-ui chart-block" data-chart>
  <figcaption class="chart-block__head">
    <h3 class="iv-block__title">{t("chart.scale.title")}</h3>
    <p class="iv-note">{t("chart.scale.note", { n: summits.length })}</p>
  </figcaption>
  <div class="chart-scroll">
    <svg class="scale-chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t("chart.scale.title")}>
      {
        grid.map((metres) => (
          <g class="chart-grid">
            <line x1={LEFT} x2={W - RIGHT} y1={y(metres)} y2={y(metres)} />
            <text x={LEFT - 6} y={y(metres) + 3.5} text-anchor="end">{metres.toLocaleString(locale)}{metres === top ? " m" : ""}</text>
          </g>
        ))
      }
      {
        drawOrder.map((peak) => (
          <a href={localizePath(lang, `/ascents/summits/${peak.summit.id}/`)} class:list={["scale-peak", { "scale-peak--attempt": peak.attempt }]} data-tip={peak.label} aria-label={peak.label.replaceAll("\n", ", ")}>
            <path class="scale-peak__fill" d={`${peak.outline}Z`} />
            <path class="scale-peak__edge" d={peak.outline} />
            <text class="scale-peak__name" transform={`translate(${f(peak.x)} ${base + 12}) rotate(-38)`} text-anchor="end">
              {peak.summit.data.name.replace(/^(Cerro|Volcán) /, "")}
            </text>
          </a>
        ))
      }
      <line class="chart-baseline" x1={LEFT} x2={W - RIGHT} y1={base} y2={base} />
    </svg>
  </div>
  <div class="iv-legend">
    <span class="iv-legend__item"><svg width="16" height="12" aria-hidden="true"><path class="scale-swatch" d="M1 11 8 1l7 10" /></svg>{t("chart.scale.reached")}</span>
    <span class="iv-legend__item"><svg width="16" height="12" aria-hidden="true"><path class="scale-swatch scale-swatch--attempt" d="M1 11 8 1l7 10" /></svg>{t("chart.scale.attempt")}</span>
  </div>
</figure>
