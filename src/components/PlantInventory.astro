---
// The digital inventory of the reforestation project: stat tiles, survival, a map of every
// plant whose position we took, a species field guide, the planting days, a flowering
// calendar, the full list and — deliberately in plain sight — what the data still lacks.
//
// Everything is computed at build time from src/data/inventory.json (generated by
// `npm run inventory` out of the field spreadsheet) and src/data/species.ts. The browser
// only gets the Leaflet map and the table filters.
import { SPECIES } from "../data/species";
import { floweringCalendar, GENERATED, ISSUES, PLANTS, speciesRows, totals, unknownSpecies, waves, type Status } from "../lib/inventory";
import { languages, getLangFromUrl, useTranslations, type UIKey } from "../i18n/ui";
import "../styles/inventory.css";

export interface Props {
  /** Public path of the spreadsheet the inventory is generated from, offered for download. */
  spreadsheet?: string;
}

const { spreadsheet } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = languages[lang].locale;

const rows = speciesRows();
const stats = totals();
const days = waves();
const calendar = floweringCalendar();
const missingSpecies = unknownSpecies();

const longDate = new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" });
const shortDate = new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", timeZone: "UTC" });
const monthInitial = new Intl.DateTimeFormat(locale, { month: "narrow", timeZone: "UTC" });
const monthShort = new Intl.DateTimeFormat(locale, { month: "short", timeZone: "UTC" });
const formatDay = (iso: string | null, format: Intl.DateTimeFormat) =>
  iso ? format.format(new Date(`${iso}T00:00:00Z`)) : "—";
const monthLabel = (month: number, format = monthInitial) => format.format(new Date(Date.UTC(2025, month - 1, 1)));

// Status order and glyph. The glyph is what keeps the status colours from carrying the
// meaning on their own, here and in the map popups.
const STATUS_ORDER = ["alive", "unchecked", "lost", "dead", "unknown"] as const;
const STATUS_GLYPH: Record<Status, string> = { alive: "✓", unchecked: "?", lost: "✕", dead: "✕", unknown: "–" };
// Status palette slot per state, so the stacked bar and the swatches never disagree.
const STATUS_FILL: Record<Status, string> = {
  alive: "var(--iv-good)",
  unchecked: "var(--iv-warning)",
  lost: "var(--iv-critical)",
  dead: "var(--iv-critical)",
  unknown: "var(--iv-muted)",
};
const statusLabel = (status: Status) => t(`cerro.status.${status}` as UIKey);
const shownStatuses = STATUS_ORDER.filter((status) => PLANTS.some((plant) => plant.status === status));

const statusParts = shownStatuses.map((status) => ({
  status,
  count: PLANTS.filter((plant) => plant.status === status).length,
}));

// Stat tiles: the headline numbers, with the caveat each one needs sitting right under it.
const tiles = [
  { value: stats.plants, label: t("cerro.stats.plants"), hint: t("cerro.stats.treesShrubs", { trees: stats.trees, shrubs: stats.shrubs }) },
  { value: stats.species, label: t("cerro.stats.species"), hint: `${stats.families} ${t("cerro.stats.families").toLowerCase()}` },
  { value: stats.endemic, label: t("cerro.stats.endemic"), hint: t("cerro.stats.ofTotal", { n: stats.plants }) },
  {
    value: stats.waves,
    label: t("cerro.stats.waves"),
    hint: t("cerro.stats.range", { from: formatDay(stats.firstDate, shortDate), to: formatDay(stats.lastDate, shortDate) }),
  },
  { value: stats.located, label: t("cerro.stats.located"), hint: t("cerro.stats.ofTotal", { n: stats.plants }) },
  { value: t("cerro.stats.extentValue", { n: stats.extent.toLocaleString(locale) }), label: t("cerro.stats.extent"), hint: "" },
];

const maxSpecies = Math.max(...rows.map((row) => row.total));
const maxWave = Math.max(...days.map((day) => day.total));
const maxFlowering = Math.max(...calendar.map((month) => month.species.length));

// Plants on the map, with everything the popup shows resolved here.
const mapPlants = PLANTS.filter((plant) => plant.lat != null && plant.lon != null).map((plant) => ({
  id: plant.id,
  code: SPECIES[plant.scientific]?.code ?? plant.id.slice(0, 2),
  name: SPECIES[plant.scientific]?.[lang].name ?? plant.name,
  scientific: plant.scientific,
  habit: plant.habit ?? "shrub",
  status: plant.status,
  statusLabel: statusLabel(plant.status),
  statusGlyph: STATUS_GLYPH[plant.status],
  planted: t("cerro.map.plantedOn", { date: formatDay(plant.planted, longDate) }),
  notes: plant.notes,
  lat: plant.lat,
  lon: plant.lon,
}));
---

<section class="plant-inventory not-prose">
  <div class="iv-block">
    <h2 class="iv-block__title">{t("cerro.inv.title")}</h2>
    <p class="iv-note">
      {t("cerro.inv.intro")}
      {" "}
      <span>{t("cerro.inv.generated", { date: formatDay(GENERATED, longDate) })}.</span>
    </p>
    <div class="iv-stats">
      {
        tiles.map((tile) => (
          <div class="iv-stat">
            <span class="iv-stat__value iv-num">{tile.value}</span>
            <span class="iv-stat__label">{tile.label}</span>
            {tile.hint && <span class="iv-stat__hint">{tile.hint}</span>}
          </div>
        ))
      }
    </div>
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.inv.statusTitle")}</h3>
    <p class="iv-note">{t("cerro.inv.statusNote")}</p>
    <div class="iv-statusbar" role="img" aria-label={statusParts.map((part) => `${part.count} ${statusLabel(part.status)}`).join(", ")}>
      {
        statusParts.map((part) => (
          <div
            class={`iv-statusbar__part iv-swatch--${part.status}`}
            style={`flex: ${part.count} 1 0; background: ${STATUS_FILL[part.status]};`}
          >
            <span style={part.status === "unchecked" ? "color: var(--iv-on-warning)" : undefined}>{part.count}</span>
          </div>
        ))
      }
    </div>
    <div class="iv-legend">
      {
        statusParts.map((part) => (
          <span class="iv-legend__item">
            <span class={`iv-swatch iv-swatch--${part.status}`} aria-hidden="true">
              {STATUS_GLYPH[part.status]}
            </span>
            {statusLabel(part.status)} <span class="iv-num">({part.count})</span>
          </span>
        ))
      }
    </div>
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.map.title")}</h3>
    <p class="iv-note">
      {t("cerro.map.note")}
      {stats.located < stats.plants && ` ${t("cerro.map.missing", { n: stats.plants - stats.located, total: stats.plants })}`}
    </p>
    <div class="plant-inventory__map" id="inventory-map"></div>
    <script type="application/json" id="inventory-map-data" set:html={JSON.stringify(mapPlants)} />
    <div class="iv-legend">
      <span class="iv-legend__item">
        <span class="iv-swatch iv-swatch--tree" aria-hidden="true"></span>{t("cerro.habit.tree")}
      </span>
      <span class="iv-legend__item">
        <span class="iv-swatch iv-swatch--shrub" aria-hidden="true"></span>{t("cerro.habit.shrub")}
      </span>
      {
        statusParts.map((part) => (
          <span class="iv-legend__item">
            <span class={`iv-swatch iv-swatch--${part.status}`} aria-hidden="true">
              {STATUS_GLYPH[part.status]}
            </span>
            {statusLabel(part.status)}
          </span>
        ))
      }
    </div>
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.species.title")}</h3>
    <div class="iv-bars">
      {
        rows.map((row) => (
          <div class="iv-bars__row">
            <span class="iv-bars__name">{row.species[lang].name}</span>
            <span class="iv-bars__track">
              <span class="iv-bars__fill" style={`--iv-w: ${(100 * row.total) / maxSpecies}%`} />
              <span class="iv-bars__value iv-num">{row.total}</span>
            </span>
          </div>
        ))
      }
    </div>
    {missingSpecies.length > 0 && <p class="iv-note" style="margin-top:.75rem">{t("cerro.species.missing", { names: missingSpecies.join(", ") })}</p>}
  </div>

  <div class="iv-block iv-species">
    {
      rows.map((row) => {
        const text = row.species[lang];
        const months = row.species.flowering.map((month) => monthLabel(month, monthShort)).join(" · ");
        return (
          <article class="iv-card iv-species__card">
            <figure class="iv-species__photo">
              <img src={row.species.photo.url} alt={t("cerro.species.photoAlt", { name: text.name })} loading="lazy" decoding="async" />
              <figcaption>
                <a href={`https://www.inaturalist.org/taxa/${row.species.inaturalist}`} rel="noopener">
                  © {row.species.photo.author} · {row.species.photo.license} · iNaturalist
                </a>
              </figcaption>
            </figure>
            <div class="iv-species__head">
              <h4 class="iv-species__name">
                {text.name}
                {text.aka && <span class="iv-species__sci"> · {text.aka}</span>}
              </h4>
              <span class="iv-species__sci">{row.scientific}</span>
              <span class="iv-species__tags">
                <span class="iv-chip">{row.total === 1 ? t("cerro.species.countOne") : t("cerro.species.count", { n: row.total })}</span>
                <span class="iv-chip">{t(`cerro.origin.${row.species.origin}` as UIKey)}</span>
                <span class="iv-chip">{row.species.code}</span>
              </span>
            </div>
            <dl class="iv-species__facts">
              <div>
                <dt>{t("cerro.species.family")}</dt>
                <dd>{row.species.family}</dd>
              </div>
              <div>
                <dt>{t("cerro.species.height")}</dt>
                <dd class="iv-num">{t("cerro.species.heightValue", { from: row.species.height[0], to: row.species.height[1] })}</dd>
              </div>
              <div>
                <dt>{t("cerro.species.flowering")}</dt>
                <dd>{months}</dd>
              </div>
            </dl>
            <p>{text.about}</p>
            <div class="iv-species__why">
              <strong>{t("cerro.species.why")}</strong>
              <p>{text.why}</p>
            </div>
            <p class="iv-species__links">
              <span>{t("cerro.species.read")}</span>
              <a href={`https://www.inaturalist.org/taxa/${row.species.inaturalist}`} rel="noopener">iNaturalist</a>
              {row.species.links.chilebosque && (
                <a href={row.species.links.chilebosque} rel="noopener">
                  Chilebosque
                </a>
              )}
              {(row.species.links.wikipedia?.[lang] ?? row.species.links.wikipedia?.es ?? row.species.links.wikipedia?.en) && (
                <a href={row.species.links.wikipedia?.[lang] ?? row.species.links.wikipedia?.es ?? row.species.links.wikipedia?.en} rel="noopener">
                  Wikipedia
                </a>
              )}
            </p>
          </article>
        );
      })
    }
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.waves.title")}</h3>
    <p class="iv-note">{t("cerro.waves.note")}</p>
    <div class="iv-waves">
      {
        days.map((day) => (
          <div class="iv-wave">
            <span class="iv-wave__date">
              {formatDay(day.date, longDate)}
              <span class="iv-wave__count iv-num">{t("cerro.waves.plants", { n: day.total })}</span>
            </span>
            <span class="iv-wave__codes">
              {day.species.map((species) => (
                <span class="iv-chip">
                  <span class="iv-chip__n">{species.count}</span>
                  {species.code}
                </span>
              ))}
            </span>
          </div>
        ))
      }
    </div>
    <div class="iv-bars" style="margin-top:.75rem">
      {
        days.map((day) => (
          <div class="iv-bars__row">
            <span class="iv-bars__name">{formatDay(day.date, shortDate)}</span>
            <span class="iv-bars__track">
              <span class="iv-bars__fill" style={`--iv-w: ${(100 * day.total) / maxWave}%`} />
              <span class="iv-bars__value iv-num">{day.total}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.flower.title")}</h3>
    <p class="iv-note">{t("cerro.flower.note")}</p>
    <div class="iv-months">
      {
        calendar.map((month) => {
          const n = month.species.length;
          return (
            <div
              class="iv-month"
              data-step={n === 0 ? 0 : Math.min(4, Math.ceil((4 * n) / maxFlowering))}
              title={`${monthLabel(month.month)}: ${t("cerro.flower.species", { n })}${n ? ` — ${month.species.join(", ")}` : ""}`}
            >
              <span class="iv-month__cell">{n || "·"}</span>
              <span class="iv-month__name">{monthLabel(month.month)}</span>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.table.title")}</h3>
    <div class="iv-filters" data-inventory-filters>
      <input type="search" data-filter-search placeholder={t("cerro.table.search")} aria-label={t("cerro.table.search")} />
      <select data-filter-species aria-label={t("cerro.table.species")}>
        <option value="">{t("cerro.table.allSpecies")}</option>
        {rows.map((row) => <option value={row.scientific}>{row.species[lang].name}</option>)}
      </select>
      <select data-filter-status aria-label={t("cerro.table.status")}>
        <option value="">{t("cerro.table.allStatus")}</option>
        {shownStatuses.map((status) => <option value={status}>{statusLabel(status)}</option>)}
      </select>
      <span
        class="iv-filters__count"
        data-filter-count
        data-template={t("cerro.table.showing", { n: "{shown}", total: stats.plants })}>{t("cerro.table.showing", { n: stats.plants, total: stats.plants })}</span>
    </div>
    <div class="iv-table-wrap">
      <table class="iv-table">
        <thead>
          <tr>
            <th>{t("cerro.table.id")}</th>
            <th>{t("cerro.table.species")}</th>
            <th>{t("cerro.table.habit")}</th>
            <th>{t("cerro.table.planted")}</th>
            <th>{t("cerro.table.status")}</th>
            <th>{t("cerro.table.position")}</th>
            <th>{t("cerro.table.notes")}</th>
          </tr>
        </thead>
        <tbody data-inventory-rows>
          {
            PLANTS.map((plant) => (
              <tr
                data-species={plant.scientific}
                data-status={plant.status}
                data-text={`${plant.id} ${plant.name} ${plant.scientific} ${SPECIES[plant.scientific]?.[lang].name ?? ""}`.toLowerCase()}
              >
                <td>{plant.id}</td>
                <td>
                  {SPECIES[plant.scientific]?.[lang].name ?? plant.name} <em>{plant.scientific}</em>
                </td>
                <td>{plant.habit ? t(`cerro.habit.${plant.habit}` as UIKey) : "—"}</td>
                <td class="iv-num">{formatDay(plant.planted, shortDate)}</td>
                <td>
                  <span class="iv-table__status">
                    <span class={`iv-swatch iv-swatch--${plant.status}`} aria-hidden="true">
                      {STATUS_GLYPH[plant.status]}
                    </span>
                    {statusLabel(plant.status)}
                  </span>
                </td>
                <td class="iv-num">
                  {plant.lat != null ? `${plant.lat.toFixed(5)}, ${plant.lon!.toFixed(5)}` : <em>{plant.locationNote ?? t("cerro.table.noPosition")}</em>}
                </td>
                <td class="iv-table__notes">{plant.notes ?? ""}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="iv-table__empty" data-inventory-empty hidden>{t("cerro.table.empty")}</p>
    </div>
    {
      spreadsheet && (
        <p class="iv-note" style="margin-top:.5rem">
          <a href={spreadsheet} download>
            {t("cerro.table.download")}
          </a>
        </p>
      )
    }
  </div>

  <div class="iv-block">
    <h3 class="iv-block__title">{t("cerro.quality.title")}</h3>
    <p class="iv-note">{t("cerro.quality.note")}</p>
    <div class="iv-card">
      {
        ISSUES.length === 0 ? (
          <p style="margin:0">{t("cerro.quality.clean")}</p>
        ) : (
          <ul class="iv-issues">
            {ISSUES.map((issue) => (
              <li>
                <span class="iv-issues__kind">{t(`cerro.quality.kind.${issue.kind}` as UIKey)}</span>
                <span class="iv-issues__id">{issue.id}</span>
                <span>{issue.detail}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<script>
  // Map and table filters, on the first load and after every view-transition navigation.
  // Leaflet is only downloaded on a page that actually has the inventory.
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector(".plant-inventory")) return;
    const { initPlantInventory } = await import("../scripts/plant-inventory");
    initPlantInventory();
  });
</script>
