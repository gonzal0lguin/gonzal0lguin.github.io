---
import SideBarFooter from "./SideBarFooter.astro";
import Img from "./Img.astro";
import SideBarMenu from "./SideBarMenu.astro";
import SiteControls from "./SiteControls.astro";
import { getLangFromUrl, localizePath } from "../i18n/ui";

const { sideBarActiveItemID } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[16rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-fit mx-auto mt-5 mb-4">
      <a href={localizePath(lang, "/")}>
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div class="w-28">
            <Img class="mask mask-circle aspect-square object-cover" sizes="112px" src="/assets/img/headers/profile-photo.JPG" alt="Gonzalo Olguín" priority />
          </div>
        </div>
      </a>
    </div>
    <div class="hidden lg:flex justify-center mb-4">
      <SiteControls />
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
