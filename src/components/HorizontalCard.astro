---
import { Image } from "astro:assets";

// The whole card is clickable through the title link's ::after overlay, so the tag
// links can sit on top of it (links can't be nested inside each other in HTML).
const { title, img, desc, url, badge, tags, tagBaseUrl, target = "_self" } = Astro.props;
---

<div class="relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt=""
          class="max-w-full md:max-w-[13rem] rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <h2 class="text-xl font-bold">
        <a href={url} target={target} class="after:absolute after:inset-0 after:content-['']">{title}</a>
        {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
      </h2>
      <p class="py-1 text-1xl">{desc}</p>
      <div class="card-actions justify-end">
        {
          tags &&
            tags.map((tag) =>
              tagBaseUrl ? (
                <a href={`${tagBaseUrl}/${tag}`} class="badge badge-outline relative z-10 hover:badge-primary">
                  {tag}
                </a>
              ) : (
                <span class="badge badge-outline">{tag}</span>
              ),
            )
        }
      </div>
    </div>
  </div>
</div>
