---
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/ui";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  { id: "home", href: "/", label: t("nav.home") },
  { id: "cv", href: "/cv", label: t("nav.cv") },
  { id: "projects", href: "/projects", label: t("nav.projects") },
  { id: "ascents", href: "/ascents", label: t("nav.mountaineering") },
  { id: "blog", href: "/blog", label: t("nav.news") },
];
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  {
    items.map((item) => (
      <li>
        <a
          class:list={["py-3 text-base", { [activeClass]: item.id === sideBarActiveItemID }]}
          id={item.id}
          href={localizePath(lang, item.href)}
          aria-current={item.id === sideBarActiveItemID ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))
  }
  <li>
    <a class="py-3 text-base" href="mailto:golguinm@gmail.com">{t("nav.contact")}</a>
  </li>
</ul>
