---
// Title of the Mountaineering section with its tabs: the log, the summits, the routes, the view from them and the tools.
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/ui";

export interface Props {
  active: "log" | "summits" | "routes" | "horizon" | "tools";
}

const { active } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tabs = [
  { id: "log", href: localizePath(lang, "/ascents"), label: t("ascents.tabLog"), icon: "M3 20l6.5-11 4 6.5 2.5-4L21 20z" },
  { id: "summits", href: localizePath(lang, "/ascents/summits/"), label: t("ascents.tabSummits"), icon: "M2 20 9 8l3.5 5L15 10l7 10z" },
  { id: "routes", href: localizePath(lang, "/ascents/routes/"), label: t("ascents.tabRoutes"), icon: "M3 17l4-6 4 3 5-8 5 6M3 21h18" },
  { id: "horizon", href: localizePath(lang, "/ascents/horizon/"), label: t("ascents.tabHorizon"), icon: "M2 16h20M5 16a7 7 0 0 1 14 0M12 5V3M4.2 8.2 2.8 6.8M19.8 8.2l1.4-1.4M7 20h10" },
  { id: "tools", href: localizePath(lang, "/ascents/tools/"), label: t("ascents.tabTools"), icon: "M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.8-.7-.7-2.8z" },
];
---

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-3xl font-bold">{t("ascents.title")}</h1>
  {/* daisyUI lays the tabs out on a single grid row, which pushes the widest label off the
      screen on a phone; a wrapping flex row lets them fall onto a second line instead. */}
  <nav role="tablist" class="tabs tabs-boxed flex flex-wrap bg-base-200" aria-label={t("ascents.title")}>
    {
      tabs.map((tab) => (
        <a role="tab" href={tab.href} class:list={["tab h-auto min-h-8 gap-2 whitespace-nowrap py-1.5", { "tab-active": tab.id === active }]} aria-selected={tab.id === active ? "true" : "false"}>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={tab.icon} />
          </svg>
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>
