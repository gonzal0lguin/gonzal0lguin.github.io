---
// Title of the Mountaineering section with its tabs: the log, the summits, the routes and the route tool.
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/ui";

export interface Props {
  active: "log" | "summits" | "routes" | "route-tool";
}

const { active } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tabs = [
  { id: "log", href: localizePath(lang, "/ascents"), label: t("ascents.tabLog"), icon: "M3 20l6.5-11 4 6.5 2.5-4L21 20z" },
  { id: "summits", href: localizePath(lang, "/ascents/summits/"), label: t("ascents.tabSummits"), icon: "M2 20 9 8l3.5 5L15 10l7 10z" },
  { id: "routes", href: localizePath(lang, "/ascents/routes/"), label: t("ascents.tabRoutes"), icon: "M3 17l4-6 4 3 5-8 5 6M3 21h18" },
  { id: "route-tool", href: localizePath(lang, "/ascents/route-tool"), label: t("ascents.tabRouteTool"), icon: "M4 19c3-1 3-5 6-6s6 1 8-3M4 19h.01M18 10V4m0 0-2.5 2.5M18 4l2.5 2.5" },
];
---

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-3xl font-bold">{t("ascents.title")}</h1>
  <nav role="tablist" class="tabs tabs-boxed bg-base-200" aria-label={t("ascents.title")}>
    {
      tabs.map((tab) => (
        <a role="tab" href={tab.href} class:list={["tab gap-2", { "tab-active": tab.id === active }]} aria-selected={tab.id === active ? "true" : "false"}>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={tab.icon} />
          </svg>
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>
