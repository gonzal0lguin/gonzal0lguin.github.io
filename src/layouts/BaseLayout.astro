---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ViewTransitions } from "astro:transitions";

import { TRANSITION_API, DARK_THEME, LIGHT_THEME, THEME_STORAGE_KEY } from "../config";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  image,
  title = t("site.title"),
  description = t("site.description"),
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  published,
  modified,
  fallback,
  jsonLd,
  // "wide" for pages of cards, charts and maps, which can use the whole screen; running text
  // stays at the default, where the lines are still comfortable to read.
  width = "default",
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={DARK_THEME}>
  <head>
    <!-- Apply the saved theme before first paint, and again after every view-transition swap
         (the swap replaces <html> attributes with the new page's defaults). -->
    <script is:inline define:vars={{ DARK_THEME, LIGHT_THEME, THEME_STORAGE_KEY }}>
      const applyTheme = () => {
        let saved = null;
        try {
          saved = localStorage.getItem(THEME_STORAGE_KEY);
        } catch {}
        document.documentElement.dataset.theme = saved === LIGHT_THEME ? LIGHT_THEME : DARK_THEME;
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <BaseHead title={title} description={description} image={image} ogType={ogType} published={published} modified={modified} fallback={fallback} jsonLd={jsonLd} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header />
        <div class="md:flex md:justify-center">
          <main class:list={["w-full max-w-[100vw] px-4 pt-5 pb-8 sm:px-6 lg:px-10 lg:pt-10", width === "wide" ? "lg:max-w-[1400px]" : "lg:max-w-[980px]"]}>
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <script>
      // Carousels and the gallery lightbox, on the first load and after every
      // view-transition navigation. Only downloaded on pages that have photos.
      document.addEventListener("astro:page-load", async () => {
        if (!document.querySelector("[data-carousel], [data-lightbox]")) return;
        const { initMedia } = await import("../scripts/media");
        initMedia();
      });
    </script>
  </body>
</html>
