---
import { type AscentsSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends AscentsSchema {}

const {
  title,
  description,
  pubDate,
  heroImage,
  badge,
  mountain,
  elevation,
  tags,
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {
        heroImage && (
          <img src={heroImage} alt={title} class="w-full mb-6 rounded-xl" />
        )
      }
      <div class="">
        <h1 class="title my-2 text-4xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <div class="flex place-content-between items-center text-sm mb-4">
          <div class="grow md:grow-0">
            { mountain && <span class="mr-4"><strong>Mountain:</strong> {mountain}</span> }
            { elevation && elevation > 0 && <span class="mr-4"><strong>Elevation:</strong> {elevation} m</span> }
            <span><strong>Date:</strong> {displayDate}</span>
          </div>
        </div>
        <div>
          {
            tags && tags.map((tag) => (
              <a href={`/ascents/tag/${tag}`} class="badge badge-outline mr-2 no-underline">
                {tag}
              </a>
            ))
          }
        </div>
      </div>
      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
