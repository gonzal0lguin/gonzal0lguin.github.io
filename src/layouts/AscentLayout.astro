---
import { type AscentsSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import UntranslatedNotice from "../components/UntranslatedNotice.astro";
import RouteMap from "../components/RouteMap.astro";
import { routeDownloadPath } from "../lib/gpx";
import type { PostPhoto } from "../lib/photos";
import { ascentSummitIds, getSummits } from "../lib/summits";
import "../styles/inventory.css";
import "../styles/summits.css";
import { formatDate, getLangFromUrl, languages, localizePath, useTranslations } from "../i18n/ui";

export interface Props extends AscentsSchema {
  /** Entry key, e.g. "punta-canaleta" */
  slug: string;
  /** The post's photos, to show the ones with a known location on the route map */
  photos?: PostPhoto[];
  fallback?: boolean;
}

const { title, description, pubDate, heroImage, badge, mountain, elevation, tags, route, waypoints, timezone, slug, photos, fallback } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = languages[lang].locale;

// The summits of this outing (set in the Spanish post's frontmatter), and which have a panorama.
const all = await getSummits(lang);
const summits = (await ascentSummitIds(slug)).flatMap((id) => all.filter((summit) => summit.id === id));
const attempt = summits.length > 0 && summits[0].ascents.find((ascent) => ascent.key === slug)?.attempt;
const withPanorama = summits.filter((summit) => summit.panorama);

// The post in tabs: the story, the GPS route, the view from the top. One tab, no tab bar.
const TABS = [
  { id: "story", label: t("ascent.tab.story"), icon: "M4 5h16M4 10h16M4 15h10M4 20h7" },
  ...(route ? [{ id: "route", label: t("ascent.tab.route"), icon: "M4 19c3-1 3-5 6-6s6 1 8-3M4 19h.01M18 10V4m0 0-2.5 2.5M18 4l2.5 2.5" }] : []),
  ...(withPanorama.length ? [{ id: "panorama", label: t("ascent.tab.panorama"), icon: "M2 18l5-7 3 4 4-7 8 10zM2 21h20" }] : []),
];
const summitUrl = (id: string) => localizePath(lang, `/ascents/summits/${id}/`);
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" sideBarActiveItemID="ascents">
  <main class="md:flex md:justify-center">
    {/* A definite width, not just a max: the page column is sized by its content, and with the
        story tab hidden the route and panorama tabs have none of their own (contain: inline-size),
        so the whole post would shrink to the width of the tab bar. */}
    <article class="prose prose-lg w-full md:w-[750px] max-w-full prose-img:mx-auto" lang={fallback ? "es" : undefined} data-ascent>
      {fallback && <UntranslatedNotice />}
      <div class="">
        <h1 class="title my-2 text-4xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <div class="flex place-content-between items-center text-sm mb-4">
          <div class="grow md:grow-0">
            { mountain && <span class="mr-4"><strong>{t("ascents.mountain")}:</strong> {mountain}</span> }
            { elevation && elevation > 0 && <span class="mr-4"><strong>{t("ascents.elevation")}:</strong> {elevation.toLocaleString(locale)} m</span> }
            <span><strong>{t("ascents.date")}:</strong> <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time></span>
          </div>
        </div>
        {
          summits.length > 0 && (
            <div class="summit-chips not-prose" aria-label={t("ascent.summits")}>
              {summits.map((summit) => (
                <a class="summit-chip" href={summitUrl(summit.id)} title={t("ascent.summitLink", { name: summit.data.name })}>
                  <svg viewBox="0 0 16 12" aria-hidden="true"><path d="M1 11 6 3l2.5 4L10.5 5 15 11z" /></svg>
                  <span>{summit.data.name}</span>
                  <span class="summit-chip__ele">{summit.data.elevation.toLocaleString(locale)} m</span>
                  {summit.ascents.length > 1 && <span class="summit-chip__count">×{summit.ascents.length}</span>}
                </a>
              ))}
              {attempt && <span class="badge badge-outline">{t("ascent.attempt")}</span>}
            </div>
          )
        }
        <div>
          {
            tags && tags.map((tag) => (
              <a href={localizePath(lang, `/ascents/tag/${tag}`)} class="badge badge-outline mr-2 no-underline">
                {tag}
              </a>
            ))
          }
        </div>
      </div>

      {
        TABS.length > 1 ? (
          <div class="ascent-tabs not-prose" role="tablist" aria-label={title}>
            {TABS.map((tab, i) => (
              <button type="button" role="tab" class="ascent-tabs__tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={tab.id}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={tab.icon} /></svg>
                {tab.label}
              </button>
            ))}
          </div>
        ) : (
          <div class="divider my-2"></div>
        )
      }

      <div id="panel-story" role="tabpanel" aria-labelledby="tab-story" data-tab-panel="story">
        {
          heroImage && (
            <img src={heroImage} alt="" class="w-full mb-6 rounded-xl" />
          )
        }
        <slot />
      </div>

      {
        route && (
          <div id="panel-route" role="tabpanel" aria-labelledby="tab-route" data-tab-panel="route" hidden>
            <RouteMap
              files={route}
              waypoints={waypoints}
              download={routeDownloadPath(route, slug, waypoints)}
              kml={localizePath(lang, `/routes/${slug}.kml`)}
              photos={photos}
              title={mountain ?? title}
              timezone={timezone}
            />
          </div>
        )
      }

      {
        withPanorama.length > 0 && (
          <div id="panel-panorama" role="tabpanel" aria-labelledby="tab-panorama" data-tab-panel="panorama" class="not-prose summit-ui" hidden>
            {withPanorama.length > 1 && (
              <div class="summit-picker" role="group" aria-label={t("ascent.pickSummit")}>
                {withPanorama.map((summit, i) => (
                  <button type="button" class="mp-jump__btn" aria-pressed={i === 0 ? "true" : "false"} data-summit-pick={summit.id}>
                    {summit.data.name}
                  </button>
                ))}
              </div>
            )}
            {withPanorama.map((summit, i) => (
              <section class="summit-frame" data-summit-frame={summitUrl(summit.id)} data-summit-id={summit.id} hidden={i > 0}>
                <header class="summit-frame__head">
                  <h2>{t("ascent.viewFrom", { name: summit.data.name })}</h2>
                  <a href={summitUrl(summit.id)}>
                    {summit.ascents.length > 1 ? t("ascent.summitPageMany", { n: summit.ascents.length }) : t("ascent.summitPage")} →
                  </a>
                </header>
                <p class="iv-note summit-frame__status" data-summit-status>
                  {t("ascent.loadingPanorama")}
                </p>
              </section>
            ))}
          </div>
        )
      }
    </article>
  </main>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-ascent] [data-tab]")) return;
    const { initAscentTabs } = await import("../scripts/ascent-tabs");
    initAscentTabs();
  });
</script>
