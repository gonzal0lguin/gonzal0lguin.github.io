---
import type { InferGetStaticPropsType } from "astro";
import PostLayout from "../../../layouts/PostLayout.astro";
import { entryStaticPaths } from "../../../lib/paths";

export function getStaticPaths() {
  return entryStaticPaths("blog");
}

const { item } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content } = await item.entry.render();
---

<PostLayout {...item.entry.data} tagBasePath="/blog/tag" sideBarActiveItemID="blog" fallback={item.fallback}>
  <Content />
</PostLayout>
