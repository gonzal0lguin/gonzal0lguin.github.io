---
import type { GetStaticPathsOptions } from "astro";
import TagPage from "../../../../../components/TagPage.astro";
import { tagStaticPaths } from "../../../../../lib/paths";

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return tagStaticPaths("blog", paginate);
}

const { page, tag } = Astro.props;
---

<TagPage page={page} tag={tag} basePath="/blog" sideBarActiveItemID="blog" />
