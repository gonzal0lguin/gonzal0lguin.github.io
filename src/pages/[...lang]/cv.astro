---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UntranslatedNotice from "../../components/UntranslatedNotice.astro";
import TimeLine from "../../components/cv/TimeLine.astro";
import TimeLineGroup from "../../components/cv/TimeLineGroup.astro";
import SectionTitle from "../../components/cv/SectionTitle.astro";
import Columns from "../../components/cv/Columns.astro";
import { getLocalizedEntry } from "../../i18n/content";
import { langStaticPaths } from "../../lib/paths";
import { LINKS } from "../../config";
import { getLang, useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

// CV content: src/content/pages/cv.mdx (and en/cv.mdx)
const { entry, fallback } = await getLocalizedEntry("pages", lang, "cv");
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description} sideBarActiveItemID="cv">
  {fallback && <UntranslatedNotice />}
  <header class="mb-10">
    <h1 class="text-4xl font-bold sm:text-5xl">Gonzalo Olguín Moncada</h1>
    <p class="mt-2 text-lg">{t("cv.role")}</p>
    <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
      <a class="link" href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="link" href={LINKS.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a class="link" href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
      <a class="link" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
      <a href="/assets/pdf/cv.pdf" download="cv_gonzalo_olguin.pdf" class="btn btn-outline btn-sm">{t("cv.download")}</a>
    </p>
  </header>
  <div lang={fallback ? "es" : undefined} class="[&>p]:mb-10 [&_ul]:list-disc [&_ul]:mx-6 [&_a]:link">
    <Content components={{ TimeLine, TimeLineGroup, Columns, h2: SectionTitle }} />
  </div>
</BaseLayout>
