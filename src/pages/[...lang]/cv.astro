---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UntranslatedNotice from "../../components/UntranslatedNotice.astro";
import TimeLine from "../../components/cv/TimeLine.astro";
import TimeLineGroup from "../../components/cv/TimeLineGroup.astro";
import SectionTitle from "../../components/cv/SectionTitle.astro";
import Columns from "../../components/cv/Columns.astro";
import { getLocalizedEntry } from "../../i18n/content";
import { langStaticPaths } from "../../lib/paths";
import { getLang, useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

// CV content: src/content/pages/cv.mdx (and en/cv.mdx)
const { entry, fallback } = await getLocalizedEntry("pages", lang, "cv");
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description} sideBarActiveItemID="cv">
  {fallback && <UntranslatedNotice />}
  <div lang={fallback ? "es" : undefined} class="[&>p]:mb-10 [&>p]:text-justify [&_ul]:list-disc [&_ul]:mx-6">
    <Content components={{ TimeLine, TimeLineGroup, Columns, h2: SectionTitle }} />
  </div>

  <div class="mt-12 mb-8 flex justify-center">
    <a href="/assets/pdf/cv.pdf" download="cv_gonzalo_olguin.pdf" class="btn btn-outline">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      {t("cv.download")}
    </a>
  </div>
</BaseLayout>
