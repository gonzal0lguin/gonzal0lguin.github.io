---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getLocalizedCollection, getLocalizedEntry } from "../../i18n/content";
import { langStaticPaths } from "../../lib/paths";
import { getLang, localizePath, useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

// Intro text: src/content/pages/home.md (and en/home.md)
const { entry: home } = await getLocalizedEntry("pages", lang, "home");
const { Content: Intro } = await home.render();

const sections = [
  { title: t("home.latestNews"), basePath: "/blog", items: await getLocalizedCollection("blog", lang) },
  { title: t("home.latestProjects"), basePath: "/projects", items: await getLocalizedCollection("projects", lang) },
  { title: t("home.latestAscents"), basePath: "/ascents", items: await getLocalizedCollection("ascents", lang) },
];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    {home.data.greeting && <div class="text-xl py-1">{home.data.greeting}</div>}
    <h1 class="text-5xl font-bold">{home.data.title}</h1>
    {home.data.subtitle && <div class="text-3xl py-3 font-bold">{home.data.subtitle}</div>}
    <div class="py-2 text-lg [&_a]:link">
      <Intro />
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:golguinm@gmail.com">{t("home.connect")}</a>
      <a href={localizePath(lang, "/cv")} class="btn btn-outline ml-5">{t("home.viewCv")}</a>
    </div>
  </div>

  {
    sections.map((section) => (
      <>
        <h2 class="text-3xl w-full font-bold mb-5 mt-10">{section.title}</h2>
        {section.items.slice(0, 3).map(({ key, entry }) => (
          <>
            <HorizontalCard
              title={entry.data.title}
              img={entry.data.heroImage}
              desc={entry.data.description}
              url={localizePath(lang, `${section.basePath}/${key}`)}
              badge={entry.data.badge}
              tags={entry.data.tags}
              tagBaseUrl={localizePath(lang, `${section.basePath}/tag`)}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    ))
  }
</BaseLayout>
