---
import type { InferGetStaticPropsType } from "astro";
import AscentLayout from "../../../layouts/AscentLayout.astro";
import { entryStaticPaths } from "../../../lib/paths";

export function getStaticPaths() {
  return entryStaticPaths("ascents");
}

const { item } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
// `photos`: the post's photos, collected by src/plugins/remark-media.mjs for the route map
const { Content, remarkPluginFrontmatter } = await item.entry.render();
---

<AscentLayout {...item.entry.data} slug={item.key} photos={remarkPluginFrontmatter.photos} fallback={item.fallback}>
  <Content />
</AscentLayout>
