---
import BaseLayout from "../../layouts/BaseLayout.astro";

const categories = [
  {
    title: "Academic projects",
    desc: "Projects developed during my university courses and research.",
    url: "/projects/academic-projects",
    img: "/assets/img/headers/about.JPG"
  },
  {
    title: "Hobby projects",
    desc: "Fun side-projects, robotics, and engineering experiments.",
    url: "/projects/hobby-projects",
    img: "/assets/img/headers/about.JPG"
  },
  {
    title: "Personal",
    desc: "Woodworking, DIY, and other personal creations.",
    url: "/projects/personal",
    img: "/assets/img/headers/about.JPG"
  }
];
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Projects</div>
  </div>

  <div class="mb-10 text-justify">
    <img src="/assets/img/headers/about.JPG" class="w-full max-h-[300px] object-cover rounded-xl mb-6 shadow-md" alt="Projects Header" />
    <p class="text-lg">
      Welcome to my project portfolio! Here you can find detailed binnacles for all the things I've built, researched, or tinkered with. To keep things organized, I've split them into categories. Choose a category below to see the related projects.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      categories.map((cat) => (
        <a href={cat.url} class="card bg-base-100 shadow-xl image-full hover:scale-[102%] transition-all cursor-pointer">
          <figure><img src={cat.img} alt={cat.title} class="object-cover" /></figure>
          <div class="card-body justify-end bg-black bg-opacity-40 rounded-xl">
            <h2 class="card-title text-white text-2xl">{cat.title}</h2>
            <p class="text-gray-200 flex-grow-0">{cat.desc}</p>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
