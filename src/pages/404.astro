---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" includeSidebar={false}>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🏔️</h1>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">No pudimos encontrar la página que buscas.</h3>
    <h3 class="text-2xl opacity-70" lang="en">The page you're looking for couldn't be found.</h3>
    <div class="mt-9 flex gap-4 justify-center">
      <a class="btn btn-accent" href="/">Inicio</a>
      <a class="btn btn-outline" href="/en/" lang="en">Home</a>
    </div>
  </div>
</BaseLayout>
